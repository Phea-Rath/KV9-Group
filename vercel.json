{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "{pages,includes,images}/**"
    },
    "ajax_lang.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/api/ajax_lang.php", "dest": "ajax_lang.php" },
    { "src": "/(.*)", "dest": "index.php" }
  ]
}